{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "EventLog": {
      "SourceName": "Echo Bot Service",
      "LogName": "Application",
      "LogLevel": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    }
  },

  "AppSettings": {
    "AadAppId": "<BOT_AAD_APP_ID>",
    "AadAppSecret": "<BOT_AAD_APP_SECRET>",
    "AadTenantId": "<TENANT_ID>",
    "ServiceDnsName": "lisa.<your-domain>",
    "CertificateThumbprint": "<PFX-cert-thumbprint>",
    "MediaDnsName": "lisa.<your-domain>",
    "BotCallingInternalPort": 9441,
    "BotInternalPort": 9442,
    "MediaInternalPort": 8445,
    "BotInstanceExternalPort": 443,
    "MediaInstanceExternalPort": 8445,
    "UseLocalDevSettings": false,
    "UseSpeechService": false,
    "SpeechConfigRegion": "",
    "SpeechEndpoint": "",
    "BotLanguage": "de-DE",
    "InvoiceAgentEndpoint": "",
    "AvatarEndpoint": "ws://localhost:5001",
    "UseAvatar": true,
    "ReceiveUnmixedMeetingAudio": true,
    "MediaPlayoutBufferMs": 1000
  }
}