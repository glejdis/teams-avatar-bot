# ──────────────────────────────────────────────────────────────
# Lisa Avatar Sidecar — required environment variables
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Azure Voice Live / AI Foundry resource endpoint.
# In agent mode the sidecar auto-rewrites cognitiveservices.azure.com
# → services.ai.azure.com, so either host is fine here.
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/

# OPTIONAL: API key authentication.
# Leave EMPTY to use Entra ID — recommended for prod.
# With Entra ID the principal needs: "Cognitive Services User" + "Azure AI User"
# on the Foundry resource.
# AZURE_VOICELIVE_API_KEY=

# Pin the credential's tenant. REQUIRED on multi-tenant dev boxes,
# otherwise Voice Live may reject with "Tenant provided in token does
# not match resource token".
# Default tenant:
AZURE_TENANT_ID=<TENANT_ID>

# Voice Live API version. 2026-01-01-preview is required for
# Foundry agent mode.
AZURE_VOICELIVE_API_VERSION=2026-01-01-preview

# ──────────────────────────────────────────────────────────────
# Foundry agent mode (preferred — Lisa's brain runs in the agent)
# ──────────────────────────────────────────────────────────────
# Set all three to route the session through the deployed
# `lisa-foundry-agent`. When set, the sidecar omits instructions /
# voice / VAD / tools from session.update — those live in the agent's
# microsoft.voice-live.configuration metadata.
LISA_FOUNDRY_AGENT_NAME=lisa
LISA_FOUNDRY_AGENT_VERSION=1
LISA_FOUNDRY_PROJECT_NAME=<your-foundry-project-name>

# ──────────────────────────────────────────────────────────────
# Inline-fallback mode (used only when the agent vars above are unset)
# ──────────────────────────────────────────────────────────────
VOICELIVE_MODEL=gpt-realtime
VOICELIVE_VOICE=de-DE-KatjaNeural
LISA_LANG=de

# ──────────────────────────────────────────────────────────────
# Avatar
# ──────────────────────────────────────────────────────────────
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting

# Video resolution (must match Teams VideoSocket format). VMSS production
# currently uses 640x360 to keep avatar decode memory bounded.
LISA_FORWARD_MUXED_AUDIO=1
LISA_LATENCY_DIAG=0
VIDEO_WIDTH=640
VIDEO_HEIGHT=360
VIDEO_BITRATE=700000
LISA_VIDEO_PREROLL_MAX_FRAMES=10
LISA_MAX_FMP4_DELTA_BYTES=8388608
LISA_FMP4_PTS_BUFFER_MAX_BYTES=4194304

# ──────────────────────────────────────────────────────────────
# Cost telemetry (optional, fail-soft)
# ──────────────────────────────────────────────────────────────
# Set COST_STORE_ACCOUNT to persist one CostRecord (transport="vmss")
# per call to the shared Azure Table that the costboard reads. Leave
# empty to disable (the in-call meter still runs; nothing is written).
# On the VMSS these are injected by install.ps1 -CostStoreAccount and the
# VMSS managed identity authenticates (needs Storage Table Data Contributor).
# COST_STORE_ACCOUNT=<storage-account-name>
# COST_STORE_TABLE=callcosts
# Optional explicit overrides (precedence: connection string → key → AAD):
# COST_STORE_ENDPOINT=https://<acct>.table.core.windows.net
# COST_STORE_CONNECTION_STRING=
# COST_STORE_KEY=
# Override the avatar per-minute estimate with your invoiced rate:
# COST_AVATAR_PER_MIN=0.30
LISA_VIDEO_DECODER_QUEUE_MAX_FRAMES=12
LISA_VIDEO_DECODER_DRAIN_MAX_FRAMES=6
LISA_AUDIO_DECODER_QUEUE_MAX_CHUNKS=200
LISA_AUDIO_DECODER_DRAIN_MAX_CHUNKS=80
